# PortfolioLens configuration. Copy to `.env` (same folder) and fill in. Never commit `.env`.

# offline    = deterministic stand-ins for every agent, no model calls (default; tests and backtest run here)
# openai     = use an OpenAI Platform API key (GPT-4o mini: gpt-4o-mini)
# openrouter = use an OpenRouter API key (GPT-4o mini: openai/gpt-4o-mini)
PL_LLM_MODE=offline

# Required when PL_LLM_MODE=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional; default is https://api.openai.com/v1
# OPENAI_BASE_URL=https://api.openai.com/v1

# Required instead when PL_LLM_MODE=openrouter
OPENROUTER_API_KEY=
# Example model id: openai/gpt-4o-mini
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# PL_LLM_TIMEOUT_S=60
# PL_NEAR_THRESHOLD_BAND_PP=1.0      # passes closer than this (percentage points) go to human review
# PL_IDENTITY_MIN_CONFIDENCE=0.85    # below this a name match is treated as unresolved
# PL_OUTPUT_DIR=outputs
